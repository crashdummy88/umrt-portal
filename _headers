/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://united-mobile-rv.pages.dev https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# connect-src united-mobile-rv.pages.dev: /book/ posts to the hub's /api/book
# (one job ledger for every booking form) and portal.js reads /api/status.
# challenges.cloudflare.com: Turnstile on the booking form.

/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/design/*
  Cache-Control: public, max-age=86400, must-revalidate
